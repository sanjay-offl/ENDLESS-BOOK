# ============================================================
# What I Saw When I Was a Kid — Environment Variables
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- Firebase / Google ---
GOOGLE_CLOUD_PROJECT=your-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# --- Gemini / Vertex AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- Google Cloud Speech ---
GOOGLE_SPEECH_LANGUAGES=en-US,ta-IN,hi-IN,te-IN,ml-IN,kn-IN

# --- Google Cloud Translation ---
GOOGLE_TRANSLATION_API_KEY=your-translation-api-key

# --- Google Cloud Storage ---
GCS_BUCKET=your-project-memory-media

# --- Pub/Sub ---
PUBSUB_TOPIC=moderation-requests
PUBSUB_SUBSCRIPTION=moderation-push

# --- BigQuery ---
BIGQUERY_DATASET=analytics
BIGQUERY_TABLE=events

# --- App ---
# Base URL of the FastAPI backend. Consumed by apps/web via NEXT_PUBLIC_API_URL,
# so it is inlined at build time - no localhost strings are hardcoded anywhere.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
FOUNDER_UID=sanjay-uid-here
NODE_ENV=development

# --- CORS ---
# Comma separated list of origins the API accepts. `next dev` uses 3000, and
# falls back to 3001/3002 when the port is taken, so all three are listed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Local web development
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
