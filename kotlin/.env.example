# The Endless Book - Environment Variables (Kotlin)
# Copy to .env and fill in. NEVER commit real secrets.

# Server
PORT=8080
APP_ENV=local
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Firebase / Google Cloud
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_SPEECH_LANGUAGES=en,hi,ta,te,ml,kn

# AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Storage
STORAGE_MODE=memory
GCS_BUCKET=your-project-memory-media

# Pub/Sub
PUBSUB_TOPIC=moderation-requests

# BigQuery
BIGQUERY_DATASET=analytics

# Founder
FOUNDER_UID=sanjay-uid-here
