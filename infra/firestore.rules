rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chapters
    match /chapters/{chapterId} {
      // Public read of published chapters
      allow read: if resource.data.status == 'published';

      // Create: authenticated users, must be their own chapter
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.pages.size() == 3
        && request.resource.data.pages[0].size() <= 1500
        && request.resource.data.pages[1].size() <= 1500
        && request.resource.data.pages[2].size() <= 1500;

      // Update: owner only, cannot change status/featured/embedding
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'featured', 'embedding', 'chapterNumber']);

      // Delete: owner only
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      // Translations subcollection
      match /translations/{lang} {
        allow read: if get(/databases/$(database)/documents/chapters/$(chapterId)).data.status == 'published';
        allow write: if false; // Only server can write translations
      }
    }

    // Users
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // Counters
    match /counters/{docId} {
      allow read: if true;
      allow write: if false; // Only server can write counters
    }
  }
}
